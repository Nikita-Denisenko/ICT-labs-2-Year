<Window x:Class="WpfLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matrix Studio"
        Height="650"
        Width="950"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020">

    <Window.Resources>

        <Style x:Key="MatrixBox" TargetType="TextBox">
            <Setter Property="Background" Value="#111A2E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#273653"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="25,13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#9333EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <StackPanel Grid.Row="0" Margin="0,0,0,25">

            <TextBlock Text="MATRIX STUDIO"
                       Foreground="#A78BFA"
                       FontSize="13"
                       FontWeight="Bold"
                      />

            <TextBlock Text="Обработка матрицы"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,8,0,5"/>

            <TextBlock Text="Лабораторная работа №4 · Вариант 2"
                       Foreground="#94A3B8"
                       FontSize="15"/>

        </StackPanel>

        <!-- Информация -->

        <Border Grid.Row="1"
                Background="#151D32"
                CornerRadius="15"
                Padding="20"
                Margin="0,0,0,25">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="РАЗМЕРНОСТЬ"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBlock Text="5 × 7"
                               Foreground="#38BDF8"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="ЗАПОЛНЕНИЕ"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBlock Text="Случайное"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="ЗАМЕНА МИНИМУМА"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBlock Text="50"
                               Foreground="#34D399"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Матрицы -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Исходная матрица -->

            <Border Grid.Column="0"
                    Background="#151D32"
                    CornerRadius="18"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="01 / ORIGINAL"
                               Foreground="#38BDF8"
                               FontSize="12"
                               FontWeight="Bold"/>

                    <TextBlock Text="Исходная матрица"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,8,0,15"/>

                    <TextBox x:Name="OriginalMatrixTextBox"
                             Style="{StaticResource MatrixBox}"
                             IsReadOnly="True"
                             Height="260"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </StackPanel>
            </Border>

            <!-- Результат -->

            <Border Grid.Column="2"
                    Background="#151D32"
                    CornerRadius="18"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="02 / RESULT"
                               Foreground="#A78BFA"
                               FontSize="12"
                               FontWeight="Bold"/>

                    <TextBlock Text="Результат обработки"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,8,0,15"/>

                    <TextBox x:Name="ResultMatrixTextBox"
                             Style="{StaticResource MatrixBox}"
                             IsReadOnly="True"
                             Height="260"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </StackPanel>
            </Border>

        </Grid>

        <!-- Кнопка -->

        <StackPanel Grid.Row="3"
                    Margin="0,25,0,0"
                    HorizontalAlignment="Center">

            <Button Content="⚡  Сгенерировать и обработать"
                    Style="{StaticResource ActionButton}"
                    Click="GenerateButton_Click"/>

            <TextBlock Text="MATRIX STUDIO  •  WPF APPLICATION"
                       Foreground="#64748B"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>

        </StackPanel>

    </Grid>
</Window>
