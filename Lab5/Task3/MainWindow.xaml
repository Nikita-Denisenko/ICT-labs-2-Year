<Window x:Class="WpfLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Currency Studio"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#101322"
        Foreground="#F4F5FF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="CurrencyRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#292F46"/>
            <Setter Property="Foreground" Value="#C4C9DC"/>
            <Setter Property="BorderBrush" Value="#454D6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#392D68"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#9B82FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#A78BFA"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="CURRENCY STUDIO"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#A78BFA"/>

            <TextBlock Text="Конвертер валют"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,6,0,0"/>

            <TextBlock Text="Перевод рублей в иностранную валюту"
                       FontSize="15"
                       Foreground="#9CA3B8"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1B2033"
                CornerRadius="24"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Сумма в рублях"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="AmountTextBox"
                             Text="1000"
                             Height="48"
                             FontSize="18"
                             Padding="14,10"
                             Background="#292F46"
                             Foreground="White"
                             BorderBrush="#454D6B"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <GroupBox Grid.Row="1"
                          Header="Выберите валюту"
                          Foreground="#F4F5FF"
                          FontSize="15"
                          FontWeight="SemiBold"
                          BorderBrush="#454D6B"
                          Background="#222940"
                          Padding="12"
                          Margin="0,0,0,12">

                    <UniformGrid Columns="3">
                        <RadioButton x:Name="EuroRadioButton"
                                     Content="EUR  €"
                                     GroupName="Currency"
                                     Style="{StaticResource CurrencyRadioButtonStyle}"
                                     MinHeight="58"
                                     Margin="4"
                                     Checked="CurrencyRadioButton_Checked"/>

                        <RadioButton x:Name="DollarRadioButton"
                                     Content="USD  $"
                                     GroupName="Currency"
                                     IsChecked="True"
                                     Style="{StaticResource CurrencyRadioButtonStyle}"
                                     MinHeight="58"
                                     Margin="4"
                                     Checked="CurrencyRadioButton_Checked"/>

                        <RadioButton x:Name="HryvniaRadioButton"
                                     Content="UAH  ₴"
                                     GroupName="Currency"
                                     Style="{StaticResource CurrencyRadioButtonStyle}"
                                     MinHeight="58"
                                     Margin="4"
                                     Checked="CurrencyRadioButton_Checked"/>
                    </UniformGrid>
                </GroupBox>

                <Border Grid.Row="2"
                        Background="#252B42"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">

                    <TextBlock x:Name="RateInfoTextBlock"
                               Text="Учебный курс: 1 USD = 90 RUB"
                               FontSize="14"
                               Foreground="#9CA3B8"
                               TextWrapping="Wrap"/>
                </Border>

                <Button Grid.Row="3"
                        Content="Конвертировать"
                        Click="ConvertButton_Click"
                        Height="50"
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#7C5CFC"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"/>

                <Border Grid.Row="4"
                        Background="#252B42"
                        CornerRadius="18"
                        Padding="22">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="РЕЗУЛЬТАТ КОНВЕРТАЦИИ"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#A78BFA"/>

                        <TextBlock x:Name="ResultTextBlock"
                                   Grid.Row="1"
                                   Text="0.00 USD"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#5EEAD4"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="CURRENCY STUDIO  •  RUB → EUR / USD / UAH"
                   Foreground="#68708C"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
